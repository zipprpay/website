# Copy this file to .env (in the same server/ folder) and fill in your real values.
# server/.env is gitignored — never commit real keys.

# Required. Kit (kit.com) API key — Settings > Developer in your Kit account.
# Must stay server-side only (see README.md).
KIT_API_KEY=

# Optional. If set, new sign-ups are also enrolled in this Kit form (its numeric id).
KIT_FORM_ID=

# Optional. If set, new sign-ups are also tagged with this Kit tag (its numeric id).
KIT_TAG_ID=

# Optional. Port for the local server.
PORT=3000
